#include <cmath>
#include <iostream>
using namespace std;
int main()
{
    float s, area, a, b, c;
    cout<<"Introduzca el primer lado:"<<endl;
    cin>>a;
    cout<<"Introduzca el segundo lado:"<<endl;
    cin>>b;
    cout<<"Introduzca el tercer lado:"<<endl;
    cin>>c;
    s=(a+b+c)/2; 
    area=sqrt(s+(s-a)*(s-b)*(s-c));
    cout<<"El area es: " <<area<< "unidades cuadradas"<<endl;
    return 0;
}

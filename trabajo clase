
#include <iostream>
#include <string>
using namespace std;

const int MAX = 100;

// Estructuras
struct Usuario {
    string nombre;
    string clave;
};

struct Persona {
    string nombre;
    string fechanac;
    string ci;
    string direccion;
    string telefono;
};

// Arreglo de las estructuras declaradas
Usuario usuarios[MAX]; 
Persona personas[MAX];

int nUsuarios = 0;
int nPersonas = 0;

// Prototipos
void registrarUsuario();
void listarUsuarios();
bool login();
void menupersona();

int main() {
    int opcion;
    do {
        cout << "\n--- Sistema de login ---" << endl;
        cout << "1. Registrar usuario" << endl;
        cout << "2. Listar usuarios" << endl;
        cout << "3. Iniciar sesion" << endl;
        cout << "0. Salir" << endl;
        cout << "Seleccione una opcion: ";
        cin >> opcion;

        switch (opcion) {
        case 1:
            registrarUsuario();
            break;
        case 2:
            listarUsuarios();
            break;
        case 3:
            if (login()) {
                //menupersona();
            }
            break;
        case 0:
            cout << "Saliendo del sistema..." << endl;
            break;
        default:
            cout << "Opcion no valida." << endl;
            break;
        }
    } while (opcion != 0);

    return 0;
}

void registrarUsuario() {
    if (nUsuarios >= MAX) {
        cout << "Limite de usuarios alcanzado." << endl;
        return;
    }

    string nombre;
    cout << "\n--- Registrar Usuario ---\n";
    cout << "Ingrese usuario: ";
    cin >> nombre;

   
    for (int i = 0; i < nUsuarios; i++) {
        if (usuarios[i].nombre == nombre) {
            cout << "Error: El usuario ya existe.\n";
            return; 
        }
    }

    usuarios[nUsuarios].nombre = nombre;
    cout << "Ingrese contrasenia: ";
    cin >> usuarios[nUsuarios].clave;
    nUsuarios++;

    cout << "Usuario registrado con exito." << endl;
}

void listarUsuarios() {
    cout << "\n--- Lista de Usuarios ---\n";
    if (nUsuarios == 0) {
        cout << "No hay usuarios registrados.\n";
        return;
    }
    for (int i = 0; i < nUsuarios; i++) {
        cout << i + 1 << ". " << usuarios[i].nombre << endl;
    }
}

bool login() {
    string nombre, clave;
    cout << "\n--- Iniciar Sesion ---\n";
    cout << "Usuario: ";
    cin >> nombre; 
    cout << "Contrasenia: ";
    cin >> clave;

    for (int i = 0; i < nUsuarios; i++) {
        // Comparacion con '==' y parentesis externos
        if ((usuarios[i].nombre == nombre) && (usuarios[i].clave == clave)) {
            cout << "Bienvenido " << nombre << "!\n";
            return true;
        }
    }

    cout << "Usuario o contrasenia incorrectos.\n";
    return false;
}
